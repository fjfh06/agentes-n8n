# ============================================================
# Configuración para PostgreSQL
# ============================================================
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ============================================================
# Configuración para pgAdmin
# ============================================================
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_CONFIG_MAX_LOGIN_ATTEMPTS=
PGADMIN_PORT=

# ============================================================
# Configuración para n8n (comentado en docker-compose.yml)
# ============================================================
N8N_PORT=
N8N_USER_FOLDER=
N8N_ELASTICBEANSTALK_SSL=
N8N_DIAGNOSTICS_ENABLED=
N8N_VERSION_NOTIFICATIONS_ENABLED=
N8N_TELEMETRY_ENABLED=
